# ─── Environment Variable Template ───────────────────────────────────────────
# Copy this file to .env for local development.
# On Render, set these via the Render dashboard → Environment tab.
#
# LOCAL DEV  → DATABASE_URL points to SQLite (file below is the default)
# PRODUCTION → DATABASE_URL points to Supabase Postgres URI

DATABASE_URL=sqlite:///timetable.db
SECRET_KEY=change-me-to-a-strong-random-string
GOOGLE_SHEET_SYNC_URL=https://script.google.com/macros/s/AKfycbx5aDRf2ji2DN49PCVD3gpVD4lOdXK7zl9W9bLebbLDUqQwIQb8fFJWjDxAyVciZgDA/exec
CRON_SECRET=iim-timetable-cron-secret-2026
FLASK_DEBUG=0
PORT=5000
